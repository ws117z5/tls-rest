# Copy to .private/.env (git-ignored) for local dev, or set these as real
# environment variables in production. Resolution order per key:
#   1. OS environment variable  2. .env file  3. built-in fallback
# See go/constants/env.go.

# ---- Host / URL derivation -------------------------------------------------
# Comma-separated allowlist of EVERY hostname the app is served on. Absolute
# URLs (OAuth redirect URIs, CORS) are derived per-request from the host the
# client used, validated against this list. The FIRST entry is canonical (used
# when a request arrives with an unknown/forged Host). No ports here.
#   dev:  localhost
#   prod: example.com,www.example.com
# Add the LAN IP too if you serve it directly (note: Google OAuth will not
# accept a private IP as a redirect URI — use localhost/domain for OAuth there).
APP_HOSTS=localhost

# ---- Required secrets (server refuses to start if missing) -----------------
JWT_SIGNATURE=        # openssl rand -base64 32
GOOGLE_ID=
GOOGLE_SECRET=

# ---- Postgres --------------------------------------------------------------
# PG_ADDR may be "host" or "host:port"; if unset, PG_HOST/PG_PORT are used.
# Use PG_SSLMODE=require (or verify-full) against managed/cloud Postgres.
PG_ADDR=localhost:5432
PG_USER=
PG_PASSWORD=
# PG_HOST=localhost
# PG_PORT=5432
# PG_SSLMODE=disable

# ---- Other datastores ------------------------------------------------------
MONGO_ADDR=mongodb://localhost:27017
REDIS_ADDR=localhost:6379

# ---- OAuth (optional) ------------------------------------------------------
# Each provider is optional: leave a pair blank to hide/disable that button's
# flow (attempting it redirects to /login?error=provider_unconfigured).
# Register this exact callback for every host in APP_HOSTS, per provider:
#   Google:   /users/Auth/GoogleCallback
#   GitHub:   /users/Auth/GithubCallback
#   Facebook: /users/Auth/FacebookCallback
#   VK:       /users/Auth/VkCallback
VK_ID=0
VK_SECRET_KEY=
FACEBOOK_ID=
FACEBOOK_SECRET=
GITHUB_ID=
GITHUB_SECRET=
# GOOGLE_URL_BLANK=urn:ietf:wg:oauth:2.0:oob