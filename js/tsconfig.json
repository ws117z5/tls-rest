{
  "compilerOptions": {
    "outDir": "./dist/",        // path to output directory
    "sourceMap": true,          // allow sourcemap support
     "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler", // <-- UPDATE THIS LINE
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,

    "types": ["webpack-env", "node"],
    
    "paths": {
      "@engine/*": [ "./src/engine/*" ],
      "@modules/*": [ "./src/engine/modules/*", "./src/modules/*" ],
      "@controllers/*": [  "./src/controllers/*", "./src/engine/controllers/*" ],
      "@containers/*": [  "./src/components/containers/*", "./src/engine/components/containers/*" ],
      "@pages/*": [ "./src/components/pages/*", "./src/engine/components/pages/*" ],
      "@components/*": [  "./src/components/*", "./src/engine/components/*" ],
      "@fields/*": ["./src/engine/fields/*" ],
      "@css/*": [  "../css/*" ],
    }

  },
  "include": [
      "./src/"
, "src/modules/posts/View.tsx", "src/modules/posts/.Edit.tsx"  ]
}