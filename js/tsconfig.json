{
  "compilerOptions": {
    "outDir": "./dist/",        // path to output directory
    "sourceMap": true,          // allow sourcemap support
     "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler", // <-- UPDATE THIS LINE
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    
    "paths": {
      "@controllers/*": ["./src/js/controllers/*"],
      "@containers/*": ["./src/js/components/containers/*"],
      "@pages/*": ["./src/js/components/pages/*"],
    }

  },
  "include": [
      "./src/"
  ]
}