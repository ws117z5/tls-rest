                        <path d="m 3.6856031,188.16498 c 0.4980545,10.25992 10.7579769,5.4786 15.3400779,2.29105 4.382879,-3.08794 5.677821,-0.49805 6.076264,-6.47471 0.298833,-3.98443 0.697277,-7.86926 0.498055,-11.85369 -6.67393,-0.59767 -13.845914,0.9961 -19.3245136,4.98054 -2.888716,1.99222 -8.0684825,8.56654 -2.5898833,11.05681" fill="#f6d2a2" />
