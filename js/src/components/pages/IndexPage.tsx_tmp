                            <path d="M106.158 113.238V76.985h31.911c3.04 0 5.97.253 8.792.76 2.822.506 5.319 1.41 7.49 2.713 2.17 1.303 3.907 3.112 5.21 5.427 1.302 2.316 1.954 5.283 1.954 8.9 0 6.513-1.954 11.217-5.862 14.111-3.907 2.895-8.9 4.342-14.979 4.342h-34.516zM72.075 50.5v155h75.112c6.947 0 13.713-.868 20.298-2.605 6.585-1.737 12.446-4.414 17.584-8.032 5.137-3.618 9.226-8.286 12.265-14.002 3.04-5.717 4.559-12.483 4.559-20.298 0-9.697-2.352-17.982-7.055-24.856-4.704-6.875-11.832-11.687-21.384-14.437 6.947-3.328 12.194-7.598 15.74-12.808 3.545-5.21 5.318-11.722 5.318-19.538 0-7.236-1.194-13.314-3.582-18.235-2.388-4.92-5.753-8.864-10.095-11.831-4.341-2.967-9.551-5.102-15.63-6.404-6.078-1.303-12.808-1.954-20.189-1.954H72.075zm34.083 128.515v-42.549h37.121c7.381 0 13.315 1.7 17.802 5.102 4.486 3.401 6.73 9.081 6.73 17.041 0 4.053-.688 7.381-2.063 9.986-1.375 2.605-3.22 4.668-5.536 6.187-2.315 1.52-4.993 2.605-8.032 3.257-3.04.65-6.223.976-9.552.976h-36.47z" fill="#FFF"/>
                        </g>
                         </>  

                </svg>
                    } 
            </div>

            { false && 
                <div>
                <div style={{zIndex: 99}}>
                    <h1>Hello World,</h1>
                    <h1>this is Vladimir Koroteev page</h1>
                    <h1>Enjoy</h1>

                    { true && 
                        <h1><RunningLetters action={nameLoaded}>Vladimir</RunningLetters> <RunningLetters action={nameLoaded}>Koroteev</RunningLetters></h1>
                    }
                    
                    { namesLoaded >= 2 &&
                        <h1><RunningLetters>Software Developement and Architecture Design</RunningLetters></h1>
                    }

                    { infosLoaded >= 2 && 
                        <h1><RunningLetters>Vladimir</RunningLetters> <RunningLetters>Koroteev</RunningLetters></h1> 
                    }
                </div>

                
                <div style={parallax}>

                    <div id="group4" style={parallax__group}>
                        <div style={{...parallax__layer, ...parallax__layer__deep}}>
                            <div className="title"><h1>Group 4</h1></div>
                            <div className="title">Deep Background Layer</div>
                        </div>

                        <div style={{...parallax__layer, ...parallax__layer__fore, ...parallax__layer__deep__img}}>
                            <div className="title"><h1>Group 4</h1></div>
                            <div className="title">Foreground Layer</div>
                        </div>

                        <div style={{...parallax__layer, ...parallax__layer__base}}>
                            <div className="title"><h1>Group 4</h1></div>
                            <div className="title">Base Layer</div>
                        </div>
                        <div style={{...parallax__layer, ...parallax__layer__back, }}>
                            <div className="title"><h1>Group 4</h1></div>
                            <div className="title">Background Layer</div>
                        </div>
                    </div>
                </div>
                </div>
            }
    </div>
    )
}

  


/**
 * Styles block
 */

const webGL = {
    color: 'blue',
    width: "100%",
    height: "600px"
    //backgroundImage: 'url(' + imgUrl + ')',
};


const webGLDiv: CSS.Properties = {
    position: 'absolute',
    zIndex: 0,
    width: '100%',
    height: '100%',
    padding: 0,
    margin: 0
}


const infoDiv: CSS.Properties = {
    position: 'absolute',
    zIndex: 1,
}

const parallax: CSS.PropertiesFallback = {
    height: ['500px', '100vh'],/* fallback for older browsers */
    overflowX: 'hidden',
    overflowY: 'auto',
    WebkitPerspective: '300px',
    perspective: '300px',
}

const parallax__group: CSS.PropertiesFallback = {
    height: ['500px', '100vh'], /* fallback for older browsers */
    position: 'relative',
    
    //height: '100vh',
    WebkitTransformStyle: 'preserve-3d',
    transformStyle: 'preserve-3d', 

    WebkitTransition: '-webkit-transform 0.5s',
    transition: 'transform 0.5s'
}

 const parallax__layer: CSS.Properties = {
    position: 'absolute',
    top: 0,
    left: 0,
    right: 0,
    bottom: 0,

    //backgroundColor: '#fff',
}

const parallax__layer__fore : CSS.Properties= {
    WebkitTransform: 'translateZ(90px) scale(.7)',
    transform: 'translateZ(90px) scale(.7)',
    zIndex: 1,
}

const parallax__layer__base: CSS.Properties = {
    WebkitTransform: 'translateZ(0)',
    transform: 'translateZ(0)',
    zIndex: 4,
}

const parallax__layer__back: CSS.Properties = {
    WebkitTransform: 'translateZ(-300px) scale(2)',
    transform: 'translateZ(-300px) scale(2)',
    zIndex: 3,
}

const parallax__layer__deep: CSS.Properties = {
    WebkitTransform: 'translateZ(-600px) scale(3)',
    transform: 'translateZ(-600px) scale(3)',
    zIndex: 2,
}

const parallax__layer__deep__img: CSS.Properties = {
    background: '#000 url("/img/background.jpg") no-repeat',
    backgroundSize: 'cover',
    color: '#fff',
    height: '400px'
}

export default IndexPage;